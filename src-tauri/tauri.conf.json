{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clonosaur",
  "version": "0.1.0",
  "identifier": "com.clonosaur.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clonosaur",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0RDhFNTg1NUI2RDRBNDEKUldSQlNtMWJoZVhZdExKVnFqNjQzS0lxVUZMbHRqdnA4UC9tODBpZDRQTUVZNEh3NHRRRlViWE4K",
      "endpoints": [
        "https://github.com/cesjavi/AI_Clonosaur/releases/latest/download/latest.json"
      ]
    }
  }
}
